        {
          "name": "Listar con paginación (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"tiene data y meta\", function(){ const j=pm.response.json(); pm.expect(j).to.have.property(\"data\"); pm.expect(j.meta).to.have.all.keys(\"total\",\"page\",\"lastPage\"); });"
                ]
              }
            }
          ]
        },
