{
  "info": {
    "name": "Customers API - client-gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requiere products-ms (3001), clients-ms (3003) y client-gateway (3000) levantados. Ejecutar en orden con el Collection Runner."
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Crear cliente (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana López\",\n  \"email\": \"ana.{{runId}}@mail.com\",\n  \"phone\": \"5512345678\",\n  \"address\": \"Calle Reforma 123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json(); pm.collectionVariables.set(\"customerId\", j.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now());"
                ]
              }
            }
          ]
        },
        {
